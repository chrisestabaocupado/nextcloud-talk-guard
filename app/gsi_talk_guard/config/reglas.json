{
  "_ayuda": [
    "accion: alertar | enmascarar. Solo las reglas de tipo regex con mascara pueden enmascarar.",
    "mascara: digitos (deja los 4 primeros y los 4 ultimos digitos) | parcial (oculta el centro) | total (usa el texto de reemplazo).",
    "Las reglas de tipo palabras no distinguen mayusculas ni acentos y solo pueden alertar.",
    "Para activar el enmascaramiento cambie accion a enmascarar e importe con: occ gsi-talk-guard:reglas:importar archivo.json"
  ],
  "dominios_institucionales": [
    "imcp.gob.ve",
    "imcp.local"
  ],
  "reglas": [
    {
      "id": "credenciales",
      "nombre": "Posible contraseña o credencial",
      "tipo": "regex",
      "patron": "(?i)\\b(contrase(?:ñ|n)a|clave|password|passwd|pwd|pin|token|usuario y clave)\\b(?:\\s+[\\w.]+){0,4}?\\s*(?:\\bes\\b|:|=)[^\\n]{0,20}?(?=\\S*[\\d!@#$%^&*_.-])\\S{4,}",
      "severidad": "alta",
      "accion": "alertar",
      "mascara": "total",
      "reemplazo": "[credencial oculta por GSI]",
      "descripcion_usuario": "una contraseña o credencial"
    },
    {
      "id": "cuenta_bancaria",
      "nombre": "Número de cuenta bancaria (20 dígitos)",
      "tipo": "regex",
      "patron": "\\b\\d{4}[- ]?\\d{4}[- ]?\\d{2}[- ]?\\d{10}\\b",
      "severidad": "alta",
      "accion": "alertar",
      "mascara": "digitos",
      "descripcion_usuario": "un número de cuenta bancaria"
    },
    {
      "id": "tarjeta",
      "nombre": "Número de tarjeta de pago",
      "tipo": "regex",
      "patron": "\\b(?:\\d[ -]?){13,19}\\b",
      "severidad": "alta",
      "validar": "luhn",
      "accion": "alertar",
      "mascara": "digitos",
      "descripcion_usuario": "un número de tarjeta de pago"
    },
    {
      "id": "cedulas_multiples",
      "nombre": "Varias cédulas en un mismo mensaje",
      "tipo": "regex",
      "patron": "\\b[VvEe]-?\\s?\\d{1,2}\\.?\\d{3}\\.?\\d{3}\\b",
      "severidad": "alta",
      "umbral": 3,
      "accion": "alertar",
      "mascara": "parcial",
      "descripcion_usuario": "números de cédula"
    },
